<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:fitsSystemWindows="true">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Study Monitor · USB POC" android:textSize="23sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:text="Start only with the person's consent. Video stays on this phone. Numeric head measurements are written to Android's temporary logs for your USB-connected laptop. This does not measure learning or attention." />
    <androidx.camera.view.PreviewView android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="8dp" android:minLines="3"
        android:text="Camera stopped. Connect USB, approve USB debugging, then press Start." />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="The front-camera preview is mirrored; the numeric ML Kit angles are not. Streamlit shows calibration and decisions. Stop here to release the camera." android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/start" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Start" />
        <Button android:id="@+id/stop" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Stop" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
